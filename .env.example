# Kramix.ai Environment Configuration
# API keys are optional if running in Demo Mode or when users provide their own keys in the client UI.

# Contact email for users who do not have an API key (configured in mailto links)
NEXT_PUBLIC_CONTACT_EMAIL=support@kramix.ai

# Optional server-side fallbacks (leave empty to require user keys or demo mode)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Web Search API for live internet research (Tavily, Serper, or Brave Search)
SEARCH_API_KEY=

# Authentication & Sessions (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_secure_32_byte_secret_here

# Google OAuth Credentials (optional for Google 1-click sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-Side API Key Encryption (32-byte hex string for AES-256-GCM)
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Database (Supabase, Neon, RDS, or local)
# If left empty, Kramix automatically uses a local persistent dev fallback
DATABASE_URL=

# Stripe Payments (USD & International Cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay Payments (INR, UPI & Domestic Netbanking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
